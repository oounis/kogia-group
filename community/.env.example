# Copier vers .env.local — jamais commiter le fichier réel.
# Voir docs/STATUS.md pour où obtenir chaque valeur.

# Supabase (dashboard du projet -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Ne JAMAIS préfixer par NEXT_PUBLIC_ — ce secret ne doit jamais atteindre le navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth (Google Cloud Console -> Identifiants -> ID client OAuth)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# SMTP dédié pour les e-mails d'authentification — le SMTP par défaut de
# Supabase est limité à 2 e-mails/heure, inutilisable en production.
# Recommandé : Resend (gratuit jusqu'à 3000 e-mails/mois).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Cloudflare Turnstile (protection anti-bot sur inscription/connexion)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# URL publique de cette app (utilisée pour les redirections OAuth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
